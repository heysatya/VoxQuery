# ============================================================
# Environment Variables — Updated with Snowflake Settings
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="VDA Schema-Aware RAG"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Warehouse Selection ──────────────────────────────────────
# Options: "duckdb" | "snowflake" | "auto"
WAREHOUSE_TYPE=auto

# ── DuckDB (local dev / demo) ────────────────────────────────
DUCKDB_PATH=data/warehouse.duckdb
DUCKDB_READ_ONLY=false
DUCKDB_MAX_MEMORY=2GB
DUCKDB_THREADS=4

# ── Snowflake Connection ─────────────────────────────────────
# Account format: <org_id>-<account_id> or <locator.region>
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=VDA_SERVICE_USER
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=PROD_DB
SNOWFLAKE_SCHEMA=SALES_MART
SNOWFLAKE_ROLE=ANALYTICS_ROLE

# Auth Option A: Password (simpler, less secure)
SNOWFLAKE_PASSWORD=your_password_here

# Auth Option B: Key-Pair (recommended for production)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=optional_passphrase

# Snowflake Extraction
SNOWFLAKE_SAMPLE_ROW_LIMIT=5
SNOWFLAKE_MAX_TABLES_PER_EXTRACTION=5000
SNOWFLAKE_INCLUDE_VIEWS=true
SNOWFLAKE_QUERY_HISTORY_DAYS=90
SNOWFLAKE_QUERY_HISTORY_MIN_EXECUTIONS=3
SNOWFLAKE_QUERY_HISTORY_LIMIT=200

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Indexes ───────────────────────────────────────────────────
FAISS_INDEX_PATH=data/indexes/faiss.index
FAISS_CHUNKS_PATH=data/indexes/chunks.jsonl
FAISS_DIMENSION=1536
BM25_INDEX_PATH=data/indexes/bm25.pkl

# ── Retrieval ─────────────────────────────────────────────────
DEFAULT_TOP_K=10
DEFAULT_TOKEN_BUDGET=2500
MAX_TOKEN_BUDGET=3000
RRF_K=60