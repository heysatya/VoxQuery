# ============================================================
# Environment Variables — Schema-Aware RAG Layer
# Copy this to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="VDA Schema-Aware RAG"
APP_ENV=development                # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- DuckDB ---
DUCKDB_PATH=data/warehouse.duckdb
DUCKDB_READ_ONLY=false
DUCKDB_MAX_MEMORY=2GB
DUCKDB_THREADS=4

# --- Embeddings ---
EMBEDDING_PROVIDER=openai          # openai | local
OPENAI_API_KEY=sk-...              # Required if EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Local embedding fallback
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- FAISS ---
FAISS_INDEX_PATH=data/indexes/faiss.index
FAISS_CHUNKS_PATH=data/indexes/chunks.jsonl
FAISS_DIMENSION=1536               # Must match embedding model

# --- BM25 ---
BM25_INDEX_PATH=data/indexes/bm25.pkl

# --- Retrieval ---
DEFAULT_TOP_K=10
DEFAULT_TOKEN_BUDGET=2500
MAX_TOKEN_BUDGET=3000
RRF_K=60                           # Reciprocal Rank Fusion constant

# --- Metric Registry ---
METRICS_PATH=data/metrics.yaml
SAMPLE_QUERIES_PATH=data/sample_queries.yaml

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# --- Evaluation ---
EVAL_QUERIES_PATH=app/eval/golden_queries.yaml