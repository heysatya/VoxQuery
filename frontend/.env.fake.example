# Fake-auth environment for local browser verification.
# Copy this file to .env.fake.local (git-ignored) or use the dev:fake npm script.
# Do NOT commit real secrets here.

# Bypass Clerk — frontend renders directly in fake-auth mode.
NEXT_PUBLIC_AUTH_MODE=fake

# Backend must also run in fake mode (AUTH_MODE=fake in backend/.env or command line).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: override the tenant ID used in fake-auth requests.
NEXT_PUBLIC_VOXQUERY_TENANT_ID=00000000-0000-0000-0000-000000000101
