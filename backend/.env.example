APP_ENV=development
AUTH_MODE=fake
CONFIDENCE_THRESHOLD_PRIMARY=0.65
CONFIDENCE_THRESHOLD_POST_CLARIFICATION=0.50
SESSION_TTL_SECONDS=14400
TOKEN_BUDGET=2500
